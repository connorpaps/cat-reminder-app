# Google Cloud OAuth desktop application credentials.
# The app remains fully usable without these values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TickTick developer app credentials (https://developer.ticktick.com/manage).
# Register the redirect URI in the app's "OAuth redirect URL" field (the
# "App Service URL" field is a DIFFERENT field — an empty OAuth redirect URL
# causes: error="invalid_request", "At least one redirect_uri must be
# registered with the client."). The exact value must be:
#   http://127.0.0.1:14565/callback
# (the /callback path is required — a pathless URI is rejected by TickTick)
# The app remains fully usable without these values.
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
